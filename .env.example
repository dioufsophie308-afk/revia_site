# Copiez ce fichier en .env pour le développement local (jamais commité).
# Sur Vercel : Project → Settings → Environment Variables.
# Supabase → Project Settings → API.

# URL du projet, ex. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Clé « anon / public » UNIQUEMENT. Jamais la clé service_role.
SUPABASE_ANON_KEY=

# URL publique du site (canonical, sitemap, données structurées), ex. https://www.revia.fr
SITE_URL=
